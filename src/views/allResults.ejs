<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title><%= title %></title>
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/allResults.css" />
  </head>
  <body>
    <%- include('partials/header'); %>
    <main class="container page-grid">
      <form method="GET" action="/" class="filters-form">
        <aside class="filters" aria-label="Filters">
          <div class="filter-card">
            <h3>Filters</h3>

            <label class="filter-group">
              <span class="label-title">Building Found</span>
              <div class="options">

                <label>
                  <input type="radio" name="building" value="any" <%= !building || building === "any" ? "checked" : "" %> />
                  Any
                </label>

                <label>
                  <input type="radio" name="building" value="Halsey" <%= building === "Halsey" ? "checked" : "" %> />
                  Halsey
                </label>

                <label>
                  <input type="radio" name="building" value="Polk" <%= building === "Polk" ? "checked" : "" %> />
                  Polk
                </label>

                <label>
                  <input type="radio" name="building" value="Sage" <%= building === "Sage" ? "checked" : "" %> />
                  Sage
                </label>

              </div>
            </label>

            <div class="filter-actions">
              
              <button type="submit" class="btn primary">Apply</button>
            </div>
          </div>
        </aside>
      </form>


      <section class="results" aria-label="Search results">
        <div class="all-results">
          <div>
            <strong>All Results</strong>
          </div>
        </div>

        <div class="cards-grid">
          <!-- Dynamic content -->
          <% if (Array.isArray(lostItems) && lostItems.length) { %>
            <% lostItems.forEach(function(item){ %>
              <article class="item-card">
                <img class="photo" 
                    src="<%= item.image %>"
                    alt="photo of <%= item.name %>" />
                
                <div class="card-body">
                  <h3 class="item-name"><%= item.name %></h3>
                  <p class="location-found"><%= item.location %></p>

                  <% if (item.hours) { %>
                    <div class="hours-container">
                      <strong class="hours-title">Building Hours</strong>
                      <ul class="hours-list">
                        <% item.hours.forEach(line => { %>
                          <li><%= line %></li>
                        <% }) %>
                      </ul>
                    </div>
                  <% } else { %>
                    <p class="hours-none"><em>No hours available</em></p>
                  <% } %>


                  <p class="desc"><%= item.description %></p>

                  <div class="card-actions">
                    <form action="/claim" method="POST">
                      <input type="hidden" name="item_id" value="<%= item.id %>">
                      <button type="submit" class="btn outline">Claim</button>
                    </form>
                  </div>
                </div>
              </article>

            <% }); %>
          <% } else { %>
            <p>No items found.</p>
          <% } %>
        </div>
      </section>
    </main>
    
    <%- include('partials/footer'); %>

    <script src="/js/claimAlert.js"></script>
  </body>
</html>